{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "config/**/*",
    "scripts/**/*",
    "controllers/**/*",
    "models/**/*",
    "fixtures/**/*",
    "utils/**/*"
  ]
}